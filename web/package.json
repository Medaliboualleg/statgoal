{
  "name": "statgoal-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "build:mobile": "vite build --mode mobile",
    "cap:sync": "npm run build:mobile && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "apk": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "icons": "capacitor-assets generate --iconBackgroundColor #001D39 --splashBackgroundColor #001D39"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.3",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
